ANTHROPIC_API_KEY=meu-token-ANTHROPIC_API_KEY
HF_TOKEN=meu-token-HF_TOKEN
LLM_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=BAAI/bge-m3
DATABASE_URL=postgresql://rag_user:<SENHA>@localhost:5432/rag_training_db
RELEVANCE_THRESHOLD=0.50
API_HOST=127.0.0.1
API_PORT=8000

# --- Docker (F15): só vale para `docker compose`; o uso local sem Docker ignora estas linhas ---
# Senha do rag_user no banco do Docker (obrigatória; só vale na 1ª subida do volume)
POSTGRES_PASSWORD=<SENHA>
# Pasta de documentos do computador, ex.: /home/ana/docs ou C:/Users/ana/docs (obrigatória)
DOCS_DIR=
# No Docker, API_PORT é a porta do computador (127.0.0.1); mude se a 8000 estiver ocupada
# API_PORT=8000
# Linux: uid e gid do usuário dono dos documentos (use `id -u` e `id -g`); refaça o build
# APP_UID=1000
# APP_GID=1000
